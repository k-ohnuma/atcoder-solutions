  "query": "\n        INSERT INTO comments (user_id, solution_id, body_md)\n        VALUES ($1, $2, $3)\n        RETURNING\n            id,\n            user_id,\n            (SELECT user_name FROM users WHERE id = $1) AS \"user_name!\",\n            solution_id,\n            body_md,\n            created_at,\n            updated_at\n        ",
