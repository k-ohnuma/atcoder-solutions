  "db_name": "PostgreSQL",
  "query": "\n        UPDATE comments c\n        SET body_md = $2\n        FROM users u\n        WHERE c.id = $1\n          AND u.id = c.user_id\n        RETURNING\n            c.id,\n            c.user_id,\n            u.user_name,\n            c.solution_id,\n            c.body_md,\n            c.created_at,\n            c.updated_at\n        ",
