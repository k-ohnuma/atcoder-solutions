{
  "name": "infra",
  "version": "1.0.0",
  "main": "main.js",
  "types": "main.ts",
  "license": "MIT",
  "private": true,
  "scripts": {
    "get": "cdktn get",
    "build": "tsc",
    "synth": "cdktn synth",
    "compile": "tsc --pretty --noEmit",
    "lint": "biome lint",
    "format:write": "biome format --write",
    "format:check": "biome format",
    "check:write": "biome check --write",
    "check:check": "biome check",
    "ci": "pnpm run get && pnpm run compile && pnpm run check:check && pnpm run format:check && pnpm run lint",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "cdktn": "^0.23.4",
    "cdktn-cli": "^0.23.4",
    "constructs": "^10.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
